{{/if}}

<p style="margin:0 0 24px;text-align:center;">
  <a href="{{inboxUrl}}" style="display:inline-block;background-color:#0f766e;color:#ffffff;font-size:14px;font-weight:600;padding:12px 28px;border-radius:6px;text-decoration:none;">Review in Inbox</a>
