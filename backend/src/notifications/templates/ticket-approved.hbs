<p style="margin:0 0 16px;font-size:16px;color:#374151;">Dear {{officerName}},</p>

<p style="margin:0 0 16px;font-size:15px;line-height:1.6;color:#374151;">
  Your approval request has been <strong style="color:#059669;">approved</strong> by
  {{approverName}} ({{approverRole}}). You may now proceed to finalise the resolution.
</p>

<p style="margin:0 0 24px;text-align:center;">
  <span style="display:inline-block;background-color:#ecfdf5;color:#065f46;font-size:20px;font-weight:700;padding:12px 24px;border-radius:6px;letter-spacing:1px;">{{ticketCode}}</span>
</p>

{{#if comment}}
<div style="margin:0 0 24px;border-left:4px solid #059669;background-color:#f0fdfa;padding:12px 16px;border-radius:4px;">
  <p style="margin:0 0 4px;font-size:12px;font-weight:600;text-transform:uppercase;color:#059669;">Approver Comment</p>
  <p style="margin:0;font-size:15px;line-height:1.6;color:#374151;">{{comment}}</p>
</div>
{{/if}}

<p style="margin:0 0 24px;text-align:center;">
  <a href="{{queueUrl}}" style="display:inline-block;background-color:#0f766e;color:#ffffff;font-size:14px;font-weight:600;padding:12px 28px;border-radius:6px;text-decoration:none;">Open Ticket</a>
</p>
