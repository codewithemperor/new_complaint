<p style="margin:0 0 16px;font-size:16px;color:#374151;">
  {{#if citizenName}}Dear {{citizenName}},{{else}}Hello,{{/if}}
</p>
<p style="margin:0 0 16px;font-size:15px;line-height:1.6;color:#374151;">
  Your complaint has been reopened for further investigation:
</p>
<p style="margin:0 0 24px;text-align:center;">
  <span style="display:inline-block;background-color:#ffedd5;color:#9a3412;font-size:20px;font-weight:700;padding:12px 24px;border-radius:6px;letter-spacing:1px;">{{ticketCode}}</span>
</p>
{{#if reopenReason}}
<div style="margin:0 0 24px;border-left:4px solid #9a3412;background-color:#fff7ed;padding:12px 16px;border-radius:4px;">
  <p style="margin:0 0 4px;font-size:12px;font-weight:600;text-transform:uppercase;color:#9a3412;">Reason Given</p>
  <p style="margin:0;font-size:15px;line-height:1.6;color:#374151;">{{reopenReason}}</p>
</div>
{{/if}}
<p style="margin:0 0 24px;font-size:15px;line-height:1.6;color:#374151;">
  The handling department has been notified and will re-examine the matter.
  Reopen count: <strong>{{reopenCount}}</strong>.
</p>
<p style="margin:0;font-size:14px;color:#6b7280;">This is an automated notification. Please do not reply to this email.</p>
