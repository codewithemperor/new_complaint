<p style="margin:0 0 16px;font-size:16px;color:#374151;">
  {{#if citizenName}}Dear {{citizenName}},{{else}}Hello,{{/if}}
</p>

<p style="margin:0 0 16px;font-size:15px;line-height:1.6;color:#374151;">
  In order to continue investigating your complaint, the handling officer
  requires some additional information from you:
</p>

<p style="margin:0 0 24px;text-align:center;">
  <span style="display:inline-block;background-color:#ecfdf5;color:#065f46;font-size:20px;font-weight:700;padding:12px 24px;border-radius:6px;letter-spacing:1px;">
    {{ticketCode}}
  </span>
</p>

<p style="margin:0 0 8px;font-size:14px;color:#6b7280;"><strong>Subject:</strong> {{subject}}</p>

<div style="margin:0 0 24px;border-left:4px solid #0f766e;background-color:#f0fdfa;padding:12px 16px;border-radius:4px;">
  <p style="margin:0 0 4px;font-size:12px;font-weight:600;text-transform:uppercase;color:#0f766e;">Information Requested</p>
  <p style="margin:0;font-size:15px;line-height:1.6;color:#374151;">{{requestText}}</p>
</div>

{{#if deadlineAt}}
<p style="margin:0 0 24px;font-size:14px;color:#b45309;">
  <strong>Please respond by:</strong> {{deadlineAt}}
</p>
{{/if}}

<p style="margin:0 0 24px;font-size:15px;line-height:1.6;color:#374151;">
  Please use the link below to provide your response. Your reply will be added
  to your complaint file and the investigation will resume.
</p>

<p style="margin:0 0 24px;text-align:center;">
  <a href="{{trackUrl}}" style="display:inline-block;background-color:#0f766e;color:#ffffff;font-size:14px;font-weight:600;padding:12px 28px;border-radius:6px;text-decoration:none;">
    Respond to Request
  </a>
</p>

<p style="margin:0;font-size:14px;color:#6b7280;">
  If you do not respond, your complaint will remain on hold. This is an automated
  notification — please do not reply to this email.
</p>
