<p style="margin:0 0 16px;font-size:16px;color:#374151;">
  {{#if citizenName}}Dear {{citizenName}},{{else}}Hello,{{/if}}
</p>

<p style="margin:0 0 16px;font-size:15px;line-height:1.6;color:#374151;">
  Your complaint has been formally referred to the
  <strong>{{referredBody}}</strong> for handling, as the matter falls within their
  statutory mandate.
</p>

<p style="margin:0 0 24px;text-align:center;">
  <span style="display:inline-block;background-color:#eff6ff;color:#1e40af;font-size:20px;font-weight:700;padding:12px 24px;border-radius:6px;letter-spacing:1px;">{{ticketCode}}</span>
</p>

<p style="margin:0 0 8px;font-size:14px;color:#6b7280;"><strong>Subject:</strong> {{subject}}</p>
<p style="margin:0 0 24px;font-size:14px;color:#6b7280;"><strong>Referred to:</strong> {{referredBody}}</p>

{{#if reason}}
<div style="margin:0 0 24px;border-left:4px solid #1e40af;background-color:#eff6ff;padding:12px 16px;border-radius:4px;">
  <p style="margin:0 0 4px;font-size:12px;font-weight:600;text-transform:uppercase;color:#1e40af;">Reason</p>
  <p style="margin:0;font-size:15px;line-height:1.6;color:#374151;">{{reason}}</p>
</div>
{{/if}}

<p style="margin:0 0 24px;font-size:15px;line-height:1.6;color:#374151;">
  You may continue to track the status of your complaint using the link below.
  The referred body may contact you directly regarding next steps.
</p>

<p style="margin:0 0 24px;text-align:center;">
  <a href="{{trackUrl}}" style="display:inline-block;background-color:#0f766e;color:#ffffff;font-size:14px;font-weight:600;padding:12px 28px;border-radius:6px;text-decoration:none;">Track My Complaint</a>
</p>
