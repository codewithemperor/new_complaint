generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum Role {
  DEPARTMENT_STAFF
  DEPARTMENT_HOD
  PERMANENT_SECRETARY
  COMMISSIONER
  ADMIN
  AUDITOR
}

// Granular module permissions assignable to ADMIN users by a Super Admin.
// SUPER_ADMIN = an ADMIN with isSuperAdmin = true (bypasses all permission checks).
enum Permission {
  ALL
  INTAKE
  SCHEDULE
  COMPLAINTS
  REPORTS
  USERS
  DEPARTMENTS
  ROUTING
  SLA
  AUDIT
  APPROVALS
}

enum TicketStatus {
  SUBMITTED
  ACKNOWLEDGED
  TRIAGED
  ASSIGNED
  IN_PROGRESS
  PENDING_APPROVAL
  APPROVED
  RESOLVED
  CLOSED
  REOPENED
  ESCALATED
  REFERRED
}

enum Priority {
  P1
  P2
  P3
  P4
}

enum Channel {
  WEB
  WALK_IN
  PHONE
  LETTER
  EMAIL
}

enum Sensitivity {
  NORMAL
  SENSITIVE
  CONFIDENTIAL
}

enum AwaitingState {
  NONE
  CITIZEN
  DEPARTMENT
  APPROVAL
}

enum AttachmentKind {
  EVIDENCE
  RESOLUTION
  MINUTE
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
}

enum MovementType {
  SUBMITTED
  ROUTED
  ASSIGNED
  REASSIGNED
  RETURNED
  ESCALATED
  APPROVED
  REFERRED
  REOPENED
  CLOSED
  AUTO_ESCALATED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  RETURNED
  ESCALATED
  REFERRED
}

enum ApproverRole {
  DEPARTMENT_HOD
  PERMANENT_SECRETARY
  COMMISSIONER
}

enum AuditEventType {
  TICKET_ACKNOWLEDGED
  TICKET_STARTED
  TICKET_ASSIGNED
  TICKET_ROUTED
  INFO_REQUESTED
  APPROVAL_REQUESTED
  TICKET_APPROVED
  TICKET_RETURNED
  ESCALATION_TO_PS
  ESCALATION_TO_COMMISSIONER
  PS_DECISION
  COMMISSIONER_DECISION
  EXTERNAL_REFERRAL
  TICKET_RESOLVED
  TICKET_CLOSED
  TICKET_AUTO_CLOSED
  TICKET_REOPENED
  REOPEN_ESCALATION
  SLA_WARNING
  SLA_BREACH_ESCALATION
  TICKET_TRIAGED
  MINUTE_POSTED
  CITIZEN_INFO_REPLY
  TICKET_ARCHIVED
}

// ─────────────────────────────────────────────────────────────────────────────
// Auth models (Milestone 1)
// ─────────────────────────────────────────────────────────────────────────────

model Department {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  code        String   @unique
  description String?  @db.Text
  users       User[]
  tickets     Ticket[]
  routingRules RoutingRule[]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("departments")
}

model User {
  id            String      @id @default(uuid()) @db.Uuid
  email         String      @unique
  passwordHash  String      @map("password_hash")
  fullName      String      @map("full_name")
  role          Role
  designation   String?
  phone         String?
  departmentId  String?     @map("department_id") @db.Uuid
  department    Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  isActive      Boolean     @default(true) @map("is_active")
  isSuperAdmin  Boolean     @default(false) @map("is_super_admin")
  lastLoginAt   DateTime?   @map("last_login_at")

  assignedTickets   Ticket[]           @relation("OfficerTickets")
  triagedTickets    Ticket[]           @relation("TriagedBy")
  movementsFrom     TicketMovement[]   @relation("MovementFrom")
  movementsTo       TicketMovement[]   @relation("MovementTo")
  minutes           Minute[]           @relation("MinuteAuthor")
  approvalsActioned ApprovalRequest[]  @relation("ApprovalsActioned")
  delegationsMade   Delegation[]       @relation("Delegator")
  delegationsReceived Delegation[]     @relation("Delegate")
  auditEvents       AuditEvent[]   @relation("UserAuditEvents")
  permissions       UserPermission[]

  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@index([departmentId])
  @@index([role])
  @@index([isActive])
  @@map("users")
}

// ─────────────────────────────────────────────────────────────────────────────
// Admin permissions (granular module access for ADMIN users)
// ─────────────────────────────────────────────────────────────────────────────

model UserPermission {
  id         String     @id @default(uuid()) @db.Uuid
  userId     String     @map("user_id") @db.Uuid
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  permission Permission
  grantedAt  DateTime   @default(now()) @map("granted_at")

  @@unique([userId, permission])
  @@index([userId])
  @@map("user_permissions")
}

// ─────────────────────────────────────────────────────────────────────────────
// Ticket domain models (Milestone 2 — Intake)
// ─────────────────────────────────────────────────────────────────────────────

model Citizen {
  id          String   @id @default(uuid()) @db.Uuid
  name        String?
  email       String   @unique
  phone       String?
  lga         String?
  isAnonymous Boolean  @default(false) @map("is_anonymous")
  tickets     Ticket[]
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([phone])
  @@map("citizens")
}

model Ticket {
  id            String       @id @default(uuid()) @db.Uuid
  ticketCode    String       @unique @map("ticket_code")
  status        TicketStatus @default(SUBMITTED)
  category      String?
  priority      Priority?
  sensitivity   Sensitivity  @default(NORMAL)
  subject       String
  description   String       @db.Text
  channel       Channel      @default(WEB)
  lga           String?

  citizenId     String       @map("citizen_id") @db.Uuid
  citizen       Citizen      @relation(fields: [citizenId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  departmentId  String?      @map("department_id") @db.Uuid
  department    Department?  @relation(fields: [departmentId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  assignedOfficerId String?  @map("assigned_officer_id") @db.Uuid
  assignedOfficer   User?    @relation("OfficerTickets", fields: [assignedOfficerId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  triagedAt      DateTime?   @map("triaged_at")
  triagedById    String?     @map("triaged_by_id") @db.Uuid
  triagedBy      User?       @relation("TriagedBy", fields: [triagedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  awaiting       AwaitingState @default(NONE)

  slaStartedAt        DateTime? @map("sla_started_at")
  slaFirstRespondedAt DateTime? @map("sla_first_responded_at")
  slaPausedAt         DateTime? @map("sla_paused_at")
  slaTargetHours      Int?      @map("sla_target_hours")
  slaDueAt            DateTime? @map("sla_due_at")
  slaBreached         Boolean   @default(false) @map("sla_breached")

  trackingToken String       @unique @map("tracking_token")
  trackingPasscode String?   @map("tracking_passcode")

  resolutionText String?     @map("resolution_text") @db.Text
  resolvedAt     DateTime?   @map("resolved_at")
  resolvedById   String?     @map("resolved_by_id") @db.Uuid
  closedAt       DateTime?   @map("closed_at")
  closedReason   String?     @map("closed_reason")
  reopenCount    Int         @default(0) @map("reopen_count")
  lastReopenedAt DateTime?   @map("last_reopened_at")
  feedbackGraceDueAt DateTime? @map("feedback_grace_due_at")

  archived      Boolean      @default(false)
  archivedAt    DateTime?    @map("archived_at")

  attachments   TicketAttachment[]
  movements     TicketMovement[]
  minutes       Minute[]
  slaPauses     SlaPause[]
  approvalRequests ApprovalRequest[] @relation("TicketApprovalRequests")
  feedback      Feedback?
  auditEvents   AuditEvent[] @relation("TicketAuditEvents")
  notifications NotificationLog[]

  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  @@index([status])
  @@index([priority])
  @@index([departmentId, status])
  @@index([assignedOfficerId, status])
  @@index([triagedById])
  @@index([slaBreached, status])
  @@index([channel])
  @@index([createdAt])
  @@index([reopenCount])
  @@map("tickets")
}

model TicketAttachment {
  id           String         @id @default(uuid()) @db.Uuid
  ticketId     String         @map("ticket_id") @db.Uuid
  ticket       Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  kind         AttachmentKind @default(EVIDENCE)
  filename     String
  storedPath   String         @map("stored_path")
  mimetype     String
  sizeBytes    Int            @map("size_bytes")
  uploadedById String?        @map("uploaded_by_id") @db.Uuid
  uploadedAt   DateTime       @default(now()) @map("uploaded_at")

  @@index([ticketId])
  @@map("ticket_attachments")
}

model TicketSequence {
  id       Int @id
  year     Int @unique
  lastValue Int @default(0) @map("last_value")

  @@map("ticket_sequences")
}

model NotificationLog {
  id         String             @id @default(uuid()) @db.Uuid
  ticketId   String?            @map("ticket_id") @db.Uuid
  ticket     Ticket?            @relation(fields: [ticketId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  eventId    String             @map("event_id")
  recipient  String
  subject    String
  body       String             @db.Text
  status     NotificationStatus @default(QUEUED)
  error      String?
  sentAt     DateTime?          @map("sent_at")
  createdAt  DateTime           @default(now()) @map("created_at")

  @@index([ticketId])
  @@index([eventId])
  @@index([recipient])
  @@index([status, createdAt])
  @@map("notification_logs")
}

// ─────────────────────────────────────────────────────────────────────────────
// Triage & Routing models (Milestone 3)
// ─────────────────────────────────────────────────────────────────────────────

model TicketMovement {
  id          String       @id @default(uuid()) @db.Uuid
  ticketId    String       @map("ticket_id") @db.Uuid
  ticket      Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  type        MovementType
  fromUserId  String?      @map("from_user_id") @db.Uuid
  fromUser    User?        @relation("MovementFrom", fields: [fromUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  toUserId    String?      @map("to_user_id") @db.Uuid
  toUser      User?        @relation("MovementTo", fields: [toUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  note        String?      @db.Text
  createdAt   DateTime     @default(now()) @map("created_at")

  @@index([ticketId, createdAt])
  @@index([toUserId])
  @@index([fromUserId])
  @@map("ticket_movements")
}

model RoutingRule {
  id               String     @id @default(uuid()) @db.Uuid
  category         String
  priority         Priority?
  lga              String?
  departmentId     String     @map("department_id") @db.Uuid
  department       Department @relation(fields: [departmentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  defaultOfficerId String?    @map("default_officer_id") @db.Uuid
  priorityRank     Int        @default(0) @map("priority_rank")
  isActive         Boolean    @default(true) @map("is_active")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  @@index([category, priority, lga])
  @@index([departmentId])
  @@map("routing_rules")
}

// ─────────────────────────────────────────────────────────────────────────────
// Investigation models (Milestone 4 — Phase 3)
// ─────────────────────────────────────────────────────────────────────────────

model Minute {
  id            String   @id @default(uuid()) @db.Uuid
  ticketId      String   @map("ticket_id") @db.Uuid
  ticket        Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  authorId      String   @map("author_id") @db.Uuid
  author        User     @relation("MinuteAuthor", fields: [authorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  body          String   @db.Text
  isInternal    Boolean  @default(false) @map("is_internal")
  isResolutionDraft Boolean @default(false) @map("is_resolution_draft")

  createdAt     DateTime @default(now()) @map("created_at")

  @@index([ticketId, createdAt])
  @@index([authorId])
  @@map("minutes")
}

model SlaPause {
  id         String       @id @default(uuid()) @db.Uuid
  ticketId   String       @map("ticket_id") @db.Uuid
  ticket     Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  reason     AwaitingState
  startedAt  DateTime     @default(now()) @map("started_at")
  resumedAt  DateTime?    @map("resumed_at")

  @@index([ticketId])
  @@map("sla_pauses")
}

model ApprovalRequest {
  id               String         @id @default(uuid()) @db.Uuid
  ticketId         String         @map("ticket_id") @db.Uuid
  ticket           Ticket         @relation("TicketApprovalRequests", fields: [ticketId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  requestedById    String         @map("requested_by_id") @db.Uuid

  approverRole     ApproverRole   @default(DEPARTMENT_HOD) @map("approver_role")
  currentApproverId String?       @map("current_approver_id") @db.Uuid

  actionedById     String?        @map("actioned_by_id") @db.Uuid
  actionedBy       User?          @relation("ApprovalsActioned", fields: [actionedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  status           ApprovalStatus @default(PENDING)
  decision         String?        @db.Text
  referredBody     String?        @map("referred_body") @db.Text
  note             String?        @db.Text

  createdAt        DateTime       @default(now()) @map("created_at")
  decidedAt        DateTime?      @map("decided_at")

  @@index([ticketId])
  @@index([currentApproverId, status])
  @@index([approverRole, status])
  @@index([status])
  @@map("approval_requests")
}

// ─────────────────────────────────────────────────────────────────────────────
// Delegation (Milestone 5)
// ─────────────────────────────────────────────────────────────────────────────

model Delegation {
  id           String   @id @default(uuid()) @db.Uuid
  delegatorId  String   @map("delegator_id") @db.Uuid
  delegator    User     @relation("Delegator", fields: [delegatorId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  delegateId   String   @map("delegate_id") @db.Uuid
  delegate     User     @relation("Delegate", fields: [delegateId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  validFrom    DateTime @map("valid_from")
  validTo      DateTime @map("valid_to")
  reason       String?  @db.Text
  isActive     Boolean  @default(true) @map("is_active")

  createdAt    DateTime @default(now()) @map("created_at")

  @@index([delegateId, validFrom, validTo])
  @@index([delegatorId])
  @@map("delegations")
}

// ─────────────────────────────────────────────────────────────────────────────
// Resolution & Closure models (Milestone 6)
// ─────────────────────────────────────────────────────────────────────────────

model Feedback {
  id           String   @id @default(uuid()) @db.Uuid
  ticketId     String   @map("ticket_id") @unique @db.Uuid
  ticket       Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  satisfied    Boolean
  rating       Int?
  comment      String?  @db.Text

  createdAt    DateTime @default(now()) @map("created_at")

  @@map("feedback")
}

// ─────────────────────────────────────────────────────────────────────────────
// SLA config (Milestone 7)
// ─────────────────────────────────────────────────────────────────────────────

model SlaConfig {
  priority            Priority @id
  firstResponseHours  Int      @map("first_response_hours")
  resolutionHours     Int      @map("resolution_hours")
  warningThreshold    Float    @map("warning_threshold") @db.DoublePrecision
  // escalationChain stores a JSON array of escalation steps, e.g.:
  // [{"role":"DIRECTOR","afterHours":2},{"role":"PERMANENT_SECRETARY","afterHours":4}]
  escalationChain     Json   @map("escalation_chain") @db.JsonB
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("sla_config")
}

// ─────────────────────────────────────────────────────────────────────────────
// Audit (Milestone 8)
// ─────────────────────────────────────────────────────────────────────────────

model AuditEvent {
  id         String         @id @default(uuid()) @db.Uuid
  ticketId   String?        @map("ticket_id") @db.Uuid
  ticket     Ticket?        @relation("TicketAuditEvents", fields: [ticketId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  actorId    String?        @map("actor_id") @db.Uuid
  actor      User?          @relation("UserAuditEvents", fields: [actorId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  eventType  AuditEventType @map("event_type")
  // meta stores arbitrary JSON metadata for the event (e.g. changed fields, old/new values)
  meta       String?        @db.Text
  ip         String?
  userAgent  String?        @map("user_agent")
  createdAt  DateTime       @default(now()) @map("created_at")

  @@index([ticketId, createdAt])
  @@index([actorId, createdAt])
  @@index([eventType, createdAt])
  @@map("audit_events")
}

// ─────────────────────────────────────────────────────────────────────────────
// Reminders (Plan Phase 1.6)
// ─────────────────────────────────────────────────────────────────────────────

model Reminder {
  id         String   @id @default(uuid()) @db.Uuid
  ticketId   String   @map("ticket_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  remindAt   DateTime @map("remind_at")
  note       String?  @db.Text
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId, remindAt])
  @@index([ticketId])
  @@map("reminders")
}
